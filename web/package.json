{
  "name": "drive-transfer-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "demo": "node scripts/record-demo.mjs",
    "format": "prettier --write src e2e scripts *.ts package.json .prettierrc.json",
    "format:check": "prettier --check src e2e scripts *.ts package.json .prettierrc.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
